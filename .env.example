# AegisVault Security Configuration

# Email where intruder photos & security breach alerts should be sent
ADMIN_ALERT_EMAIL=your_email@example.com

# SMTP Server Settings for Real Email Dispatch
# For Gmail: Use smtp.gmail.com with an App Password (not your regular password)
# Guide: Google Account -> Security -> 2-Step Verification -> App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=security-vault@yourbank.com
SMTP_USE_TLS=true

# Security Tuning
FACE_MATCH_THRESHOLD=0.55
VAULT_AUTO_LOCK_SECONDS=10
INTRUDER_ALERT_COOLDOWN_SECONDS=6
MAX_FAILED_PIN_ATTEMPTS=3

# Metadata
BANK_NAME=AEGIS CENTRAL RESERVE BANK
TERMINAL_ID=TERMINAL-ALPHA-01 (VAULT ACCESS GATE)
